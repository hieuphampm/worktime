# Firebase Configuration
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Use Firebase Emulators in development
VITE_USE_EMULATORS=false

# Configure these as sensitive variables in Vercel (server-side only).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_DISPLAY_NAME=Admin
ADMIN_EMPLOYEE_ID=ADMIN001
ADMIN_DEPARTMENT=Ban Giám Đốc

# Configure this sensitive variable in both local .env and Vercel.
ADMIN_BOOTSTRAP_URL=https://worktime-xi.vercel.app/api/bootstrap-admin
ADMIN_BOOTSTRAP_TOKEN=replace-with-a-long-random-secret

# Add FIREBASE_SERVICE_ACCOUNT_JSON directly as a sensitive Vercel variable.
# Keep the service account JSON out of this file and every VITE_ variable.
