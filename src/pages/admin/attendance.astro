---
import AppLayout from '../../layouts/AppLayout.astro';
import { attendancePage, departments } from '../../lib/admin-data';
import { serviceClient } from '../../lib/supabase/server';
const p=Astro.url.searchParams; const month=p.get('month')||undefined; const monthFrom=month?`${month}-01`:undefined; const monthTo=month?`${month}-${String(new Date(Date.UTC(Number(month.slice(0,4)),Number(month.slice(5,7)),0)).getUTCDate()).padStart(2,'0')}`:undefined;
const filters={from:p.get('from')||monthFrom,to:p.get('to')||monthTo,employee:p.get('employee')||undefined,department:p.get('department')||undefined,status:p.get('status')||undefined,search:p.get('search')||undefined,sort:(p.get('sort')==='employee'||p.get('sort')==='status'?p.get('sort'):'date') as 'date'|'employee'|'status',page:Number(p.get('page')||1),pageSize:20};
const [{rows,total,page,pageSize}, deps, settingsResult, peopleResult]=await Promise.all([attendancePage(filters),departments(),serviceClient().from('company_settings').select('timezone').eq('id',1).single(),serviceClient().from('profiles').select('id,employee_id,display_name').eq('role','EMPLOYEE').eq('is_active',true).is('deleted_at',null).order('display_name')]);
const zone=settingsResult.data?.timezone||'Asia/Ho_Chi_Minh'; const fmt=(v:string|null)=>v?new Date(v).toLocaleString('sv-SE',{timeZone:zone}).replace(' ','T').slice(0,16):''; const label={FULL_DAY:'Đủ công',HALF_DAY:'Nửa buổi',OFF:'Off'} as const;
const query=new URLSearchParams(Object.fromEntries([...p.entries()].filter(([k])=>k!=='page'))).toString();
---
<AppLayout title="Quản lý chấm công" profile={Astro.locals.profile} active="/admin/attendance">
  <header class="page-head"><div><div class="eyebrow">Quản trị · Nhân sự</div><h1>Quản lý chấm công</h1><p>Tìm kiếm, lọc và hiệu chỉnh bản ghi chấm công.</p></div><a class="secondary" href="/admin/reports">Xuất báo cáo</a></header>
  <section class="form-panel"><h2>Tạo bản ghi chấm công</h2><p class="small muted">Dùng để gán trạng thái cho ngày chưa có lượt chấm công. Bản ghi có thể nhận giờ vào/ra sau đó.</p><form class="form-grid" data-create-record>
    <label>Nhân viên<select name="employee_id" required><option value="">Chọn nhân viên</option>{(peopleResult.data||[]).map(person=><option value={person.id}>{person.employee_id} · {person.display_name}</option>)}</select></label>
    <label>Ngày làm việc<input type="date" name="attendance_date" required/></label>
    <label>Trạng thái<select name="status" required><option value="FULL_DAY">Đủ công</option><option value="HALF_DAY">Nửa buổi</option><option value="OFF">Off</option></select></label>
    <label class="wide">Ghi chú<input name="notes" maxlength="2000"/></label>
    <label class="wide">Lý do tạo bản ghi<input name="reason" required minlength="4" maxlength="500"/></label>
    <div class="wide form-actions"><button class="primary" type="submit">Tạo bản ghi</button></div>
  </form></section>
  <div class="notice" data-create-feedback hidden></div>
  <section class="table-panel"><form class="filters" method="get">
    <input type="search" name="search" value={filters.search||''} placeholder="Mã hoặc tên nhân viên" aria-label="Tìm nhân viên" />
    <input type="month" name="month" value={month||''} aria-label="Tháng"/><input type="date" name="from" value={p.get('from')||''} aria-label="Từ ngày"/><input type="date" name="to" value={p.get('to')||''} aria-label="Đến ngày"/>
    <select name="department"><option value="">Tất cả phòng ban</option>{deps.map(d=><option value={d} selected={filters.department===d}>{d}</option>)}</select>
    <select name="status"><option value="">Tất cả trạng thái</option><option value="FULL_DAY" selected={filters.status==='FULL_DAY'}>Đủ công</option><option value="HALF_DAY" selected={filters.status==='HALF_DAY'}>Nửa buổi</option><option value="OFF" selected={filters.status==='OFF'}>Off</option></select><select name="sort"><option value="date" selected={filters.sort==='date'}>Sắp xếp: ngày</option><option value="employee" selected={filters.sort==='employee'}>Sắp xếp: nhân viên</option><option value="status" selected={filters.sort==='status'}>Sắp xếp: trạng thái</option></select>
    <button class="primary" type="submit">Lọc dữ liệu</button><a class="secondary" href="/admin/attendance">Xóa lọc</a>
  </form><div class="table-scroll"><table><thead><tr><th>Mã nhân viên</th><th>Nhân viên</th><th>Phòng ban</th><th>Ngày</th><th>Giờ vào</th><th>Giờ ra</th><th>Thời lượng</th><th>Trạng thái</th><th>Công</th><th>Người sửa</th><th></th></tr></thead><tbody>
  {rows.map(r=><tr><td><strong>{r.profile?.employee_id}</strong></td><td>{r.profile?.display_name}</td><td>{r.profile?.department||'—'}</td><td>{r.attendance_date}</td><td>{r.check_in_at?new Date(r.check_in_at).toLocaleTimeString('vi-VN',{timeZone:zone,hour:'2-digit',minute:'2-digit'}):'—'}</td><td>{r.check_out_at?new Date(r.check_out_at).toLocaleTimeString('vi-VN',{timeZone:zone,hour:'2-digit',minute:'2-digit'}):'—'}</td><td>{r.working_duration_minutes===null?'—':`${Math.floor(r.working_duration_minutes/60)}g ${r.working_duration_minutes%60}p`}</td><td>{r.check_in_at&&!r.check_out_at?<span class="badge badge-incomplete">Chưa hoàn tất</span>:r.status?<span class:list={{badge:true,'badge-full':r.status==='FULL_DAY','badge-half':r.status==='HALF_DAY','badge-off':r.status==='OFF'}}>{label[r.status]}</span>:'—'}</td><td>{r.attendance_credit??'—'}</td><td>{r.last_modifier?.display_name||'—'}</td><td><details><summary class="small" style="color:#2868d6;cursor:pointer">Sửa · Lịch sử</summary><div class="edit-pop"><form data-edit data-id={r.id} data-in={fmt(r.check_in_at)} data-out={fmt(r.check_out_at)} data-status={r.status||''} data-notes={r.notes||''}>
    <label>Giờ vào<input name="check_in_at" type="datetime-local" value={fmt(r.check_in_at)}/></label><label>Giờ ra<input name="check_out_at" type="datetime-local" value={fmt(r.check_out_at)}/></label><label>Trạng thái<select name="status"><option value="">Chưa phân loại</option><option value="FULL_DAY" selected={r.status==='FULL_DAY'}>Đủ công</option><option value="HALF_DAY" selected={r.status==='HALF_DAY'}>Nửa buổi</option><option value="OFF" selected={r.status==='OFF'}>Off</option></select><span class="small muted">Khi có đủ giờ vào và giờ ra, trạng thái tự tính: đủ 9 giờ là Đủ công; dưới 9 giờ là Nửa buổi.</span></label><label>Ghi chú<textarea name="notes">{r.notes||''}</textarea></label><label>Lý do hiệu chỉnh<input name="reason" required minlength="4" placeholder="Nêu lý do thay đổi"/></label><button class="primary" type="submit">Lưu thay đổi</button></form><a class="small" href={`/admin/audit?attendance=${r.id}`}>Xem lịch sử bản ghi →</a></div></details></td></tr>)}
  {!rows.length&&<tr><td colspan="11"><div class="empty">Không tìm thấy bản ghi phù hợp.</div></td></tr>}
  </tbody></table></div><div class="pagination"><span>{total} kết quả · Trang {page}</span><div>{page>1&&<a href={`?${query}${query?'&':''}page=${page-1}`}>← Trước</a>}{page*pageSize<total&&<a href={`?${query}${query?'&':''}page=${page+1}`}>Sau →</a>}</div></div></section>
  <div class="notice" data-feedback hidden></div>
  <script>
    document.querySelector<HTMLFormElement>('[data-create-record]')!.addEventListener('submit',async(event)=>{event.preventDefault();const form=event.currentTarget as HTMLFormElement;if(!window.confirm('Tạo bản ghi chấm công với trạng thái đã chọn?'))return;const fields=new FormData(form);const response=await fetch('/api/admin/attendance',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({employee_id:fields.get('employee_id'),attendance_date:fields.get('attendance_date'),status:fields.get('status'),notes:fields.get('notes')||null,reason:fields.get('reason')})});const result=await response.json();const feedback=document.querySelector<HTMLElement>('[data-create-feedback]')!;feedback.className=response.ok?'notice':'notice error';feedback.textContent=response.ok?'Đã tạo bản ghi và ghi nhật ký kiểm toán.':result.error;feedback.hidden=false;if(response.ok)window.location.reload();});
    document.querySelectorAll<HTMLFormElement>('[data-edit]').forEach((form)=>form.addEventListener('submit',async(event)=>{event.preventDefault();if(!window.confirm('Xác nhận lưu thay đổi chấm công?'))return;const fields=new FormData(form);const res=await fetch('/api/admin/attendance',{method:'PATCH',headers:{'Content-Type':'application/json'},body:JSON.stringify({id:form.dataset.id,check_in_at:fields.get('check_in_at')||null,check_out_at:fields.get('check_out_at')||null,status:fields.get('status')||null,notes:fields.get('notes')||null,reason:fields.get('reason')})});const out=await res.json();const feedback=document.querySelector<HTMLElement>('[data-feedback]')!;feedback.textContent=res.ok?'Đã lưu hiệu chỉnh.':out.error;feedback.hidden=false;if(!res.ok)feedback.classList.add('error');else window.location.reload();}));
  </script>
</AppLayout>
<style>.edit-pop{position:fixed;right:22px;top:20%;z-index:4;width:min(380px,calc(100vw - 30px));max-height:68vh;overflow:auto;background:white;border:1px solid #dfe6ef;box-shadow:0 15px 50px #20344e22;border-radius:12px;padding:16px}.edit-pop form{display:grid;gap:9px}.edit-pop label{display:grid;gap:4px;font-size:11px;color:#718093}.edit-pop input,.edit-pop select,.edit-pop textarea{border:1px solid #dfe6ef;border-radius:6px;padding:8px;font-size:12px}.edit-pop textarea{min-height:60px}</style>
