---
import AppLayout from '../../layouts/AppLayout.astro';
import { serviceClient } from '../../lib/supabase/server';
const attendanceId=Astro.url.searchParams.get('attendance'); const page=Math.max(1,Number(Astro.url.searchParams.get('page')||1)); const pageSize=40;
let q=serviceClient().from('attendance_audit_logs').select('*, person:profiles!attendance_audit_logs_employee_id_fkey(employee_id,display_name), actor:profiles!attendance_audit_logs_changed_by_fkey(display_name)',{count:'exact'}).order('created_at',{ascending:false}); if(attendanceId)q=q.eq('attendance_id',attendanceId); const {data:logs,count}=await q.range((page-1)*pageSize,page*pageSize-1);
const actorAction={CHECK_IN:'Chấm công vào',CHECK_OUT:'Chấm công ra',ADMIN_CREATE:'Tạo bản ghi',ADMIN_UPDATE:'Hiệu chỉnh',ADMIN_DELETE:'Xóa bản ghi'} as Record<string,string>; const zone=(await serviceClient().from('company_settings').select('timezone').eq('id',1).single()).data?.timezone||'Asia/Ho_Chi_Minh';
---
<AppLayout title="Nhật ký kiểm toán" profile={Astro.locals.profile} active="/admin/audit">
  <header class="page-head"><div><div class="eyebrow">Quản trị · Bảo mật</div><h1>Nhật ký hoạt động</h1><p>Lịch sử thay đổi được ghi tự động và không thể chỉnh sửa từ ứng dụng.</p></div>{attendanceId&&<a class="secondary" href="/admin/audit">Tất cả hoạt động</a>}</header>
  <section class="table-panel"><div class="panel-title"><h2>{attendanceId?'Lịch sử bản ghi':'Hoạt động gần đây'}</h2><span>{count||0} sự kiện</span></div><div class="table-scroll"><table><thead><tr><th>Thời điểm</th><th>Nhân viên</th><th>Thao tác</th><th>Người thực hiện</th><th>Lý do</th><th>Chi tiết</th></tr></thead><tbody>
  {(logs||[]).map(log=><tr><td>{new Date(log.created_at).toLocaleString('vi-VN',{timeZone:zone})}</td><td>{log.person?.display_name||'—'}<br/><span class="muted small">{log.person?.employee_id}</span></td><td>{actorAction[log.action]||log.action}</td><td>{log.actor?.display_name||'Hệ thống'}</td><td>{log.reason||'—'}</td><td><details><summary style="cursor:pointer">Xem JSON</summary><pre style="white-space:pre-wrap;max-width:400px;font-size:10px">{JSON.stringify({old:log.old_values,new:log.new_values},null,2)}</pre></details></td></tr>)}
  {!logs?.length&&<tr><td colspan="6"><div class="empty">Chưa có hoạt động được ghi nhận.</div></td></tr>}
  </tbody></table></div><div class="pagination"><span>{count||0} sự kiện · Trang {page}</span><div>{page>1&&<a href={`?${attendanceId?`attendance=${attendanceId}&`:''}page=${page-1}`}>← Trước</a>}{(count||0)>page*pageSize&&<a href={`?${attendanceId?`attendance=${attendanceId}&`:''}page=${page+1}`}>Sau →</a>}</div></div></section>
</AppLayout>
