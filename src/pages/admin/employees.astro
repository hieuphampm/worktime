---
import AppLayout from '../../layouts/AppLayout.astro';
import { serviceClient } from '../../lib/supabase/server';
const {data:people}=await serviceClient().from('profiles').select('*').order('created_at',{ascending:false});
---
<AppLayout title="Quản lý nhân viên" profile={Astro.locals.profile} active="/admin/employees">
  <header class="page-head"><div><div class="eyebrow">Quản trị · Nhân sự</div><h1>Nhân viên</h1><p>Tạo tài khoản, cập nhật thông tin và trạng thái truy cập.</p></div></header>
  <div class="notice" data-message hidden></div>
  <section class="form-panel"><h2>Tạo tài khoản mới</h2><form data-create class="form-grid">
    <label>Email công ty<input type="email" name="email" required maxlength="254"/></label><label>Mã nhân viên<input name="employee_id" required maxlength="32"/></label><label>Họ và tên<input name="display_name" required maxlength="120"/></label><label>Phòng ban<input name="department" maxlength="100"/></label><label>Vai trò<select name="role"><option value="EMPLOYEE">Nhân viên</option><option value="ADMIN">Quản trị viên</option></select></label><label>Mật khẩu ban đầu<input type="password" name="password" required autocomplete="new-password"/></label>
    <div class="wide small muted">Mật khẩu cần ít nhất 6 ký tự theo giới hạn của Supabase Auth; chia sẻ trực tiếp với nhân viên qua kênh an toàn.</div><div class="wide form-actions"><button class="primary">Tạo tài khoản</button></div>
  </form></section>
  <section class="table-panel"><div class="panel-title"><h2>Danh sách tài khoản</h2><span>{people?.length||0} tài khoản</span></div><div class="table-scroll"><table><thead><tr><th>Mã nhân viên</th><th>Họ và tên</th><th>Email</th><th>Phòng ban</th><th>Vai trò</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody>
    {(people||[]).map(person=><tr><td><strong>{person.employee_id}</strong></td><td>{person.display_name}</td><td>{person.email||'—'}</td><td>{person.department||'—'}</td><td>{person.role==='ADMIN'?'Quản trị viên':'Nhân viên'}</td><td>{person.deleted_at?<span class="badge badge-off">Đã xóa</span>:person.is_active?<span class="badge badge-full">Đang hoạt động</span>:<span class="badge badge-off">Đã vô hiệu hóa</span>}</td><td>{!person.deleted_at&&<div class="form-actions"><form data-profile data-id={person.id} data-active={person.is_active} data-employee-id={person.employee_id} data-name={person.display_name} data-department={person.department||''}><button class="secondary" type="submit">Sửa · Quyền truy cập</button></form>{person.id!==Astro.locals.user?.id&&<button class="secondary" type="button" data-delete={person.id} data-name={person.display_name}>Xóa</button>}</div>}</td></tr>)}
    {!people?.length&&<tr><td colspan="7"><div class="empty">Chưa có nhân viên. Tạo tài khoản đầu tiên ở phía trên.</div></td></tr>}
  </tbody></table></div></section>
  <script>
    const message=document.querySelector<HTMLElement>('[data-message]')!;
    async function send(method:string,payload:unknown){const response=await fetch('/api/admin/employees',{method,headers:{'Content-Type':'application/json'},body:JSON.stringify(payload)});const result=await response.json();if(!response.ok)throw new Error(result.error);}
    document.querySelector<HTMLFormElement>('[data-create]')!.addEventListener('submit',async(event)=>{event.preventDefault();const form=event.currentTarget as HTMLFormElement;const button=form.querySelector<HTMLButtonElement>('button')!;button.disabled=true;try{await send('POST',Object.fromEntries(new FormData(form)));message.className='notice';message.textContent='Đã tạo tài khoản.';message.hidden=false;window.location.reload();}catch(error){message.className='notice error';message.textContent=error instanceof Error?error.message:'Không thể tạo tài khoản';message.hidden=false;button.disabled=false;}});
    document.querySelectorAll<HTMLFormElement>('[data-profile]').forEach((form)=>form.addEventListener('submit',async(event)=>{event.preventDefault();const active=form.dataset.active==='true';const employee_id=window.prompt('Mã nhân viên',form.dataset.employeeId||'');if(employee_id===null)return;const display_name=window.prompt('Tên hiển thị',form.dataset.name||'');if(display_name===null)return;const department=window.prompt('Phòng ban (để trống nếu không có)',form.dataset.department||'');if(department===null)return;const password=window.prompt('Đặt mật khẩu mới (tối thiểu 6 ký tự; bỏ trống để giữ nguyên)')||undefined;if(password&&password.length<6){message.className='notice error';message.textContent='Supabase Auth yêu cầu mật khẩu tối thiểu 6 ký tự.';message.hidden=false;return;}if(password&&!window.confirm('Xác nhận đặt lại mật khẩu cho tài khoản này?'))return;const is_active=active?window.confirm('Tạm khóa tài khoản này?'):true;if(active&&!is_active)return;if(active&&!window.confirm('Xác nhận tạm khóa?'))return;try{await send('PATCH',{id:form.dataset.id,employee_id,display_name,department:department||null,is_active,password});window.location.reload();}catch(error){message.className='notice error';message.textContent=error instanceof Error?error.message:'Không thể cập nhật tài khoản';message.hidden=false;}}));
    document.querySelectorAll<HTMLButtonElement>('[data-delete]').forEach((button)=>button.addEventListener('click',async()=>{const name=button.dataset.name||'tài khoản này';if(!window.confirm(`Xóa ${name}? Tài khoản sẽ bị khóa và không thể đăng nhập. Lịch sử chấm công vẫn được giữ lại.`))return;button.disabled=true;try{await send('DELETE',{id:button.dataset.delete});window.location.reload();}catch(error){message.className='notice error';message.textContent=error instanceof Error?error.message:'Không thể xóa tài khoản';message.hidden=false;button.disabled=false;}}));
  </script>
</AppLayout>
