---
import AppLayout from '../layouts/AppLayout.astro';
---
<AppLayout title="Không tìm thấy" profile={Astro.locals.profile}><div style="max-width:560px;margin:15vh auto;text-align:center"><div class="eyebrow">Lỗi 404</div><h1>Không tìm thấy trang này</h1><p class="muted">Đường dẫn có thể đã thay đổi hoặc không tồn tại.</p><a class="primary" href={Astro.locals.profile?.role==='ADMIN'?'/admin':Astro.locals.profile?'/employee':'/login'}>Về trang chủ</a></div></AppLayout>
