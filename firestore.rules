rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN';
    }

    function isOwner(employeeId) {
      return isAuthenticated() && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.employeeId == employeeId;
    }

    function getUserEmployeeId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.employeeId;
    }

    // Users collection
    match /users/{userId} {
      // Only admins can read all user profiles
      // Users can read their own profile
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      
      // Only Cloud Functions (admin SDK) can create/update users
      // Admins can update non-role fields
      allow update: if isAdmin() && 
                       !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'uid']);
      
      // No client-side create or delete
      allow create, delete: if false;
    }

    // Attendance collection
    match /attendance/{attendanceId} {
      // Admins can read all records
      // Employees can only read their own records
      allow read: if isAuthenticated() && 
                    (isAdmin() || resource.data.employeeId == getUserEmployeeId());
      
      // Employees can create their own check-in record
      allow create: if isAuthenticated() && 
                      request.resource.data.employeeId == getUserEmployeeId() &&
                      request.resource.data.status == 'FULL_DAY' &&
                      request.resource.data.checkOutAt == null &&
                      request.resource.data.lastModifiedBy == null;
      
      // Employees can update ONLY to add checkOutAt (check out)
      // They cannot change status, attendanceCredit, employeeId, etc.
      allow update: if isAuthenticated() && 
                      resource.data.employeeId == getUserEmployeeId() &&
                      resource.data.checkOutAt == null &&
                      request.resource.data.checkOutAt != null &&
                      request.resource.data.status == resource.data.status &&
                      request.resource.data.attendanceCredit == resource.data.attendanceCredit &&
                      request.resource.data.employeeId == resource.data.employeeId &&
                      request.resource.data.employeeName == resource.data.employeeName &&
                      request.resource.data.date == resource.data.date &&
                      request.resource.data.checkInAt == resource.data.checkInAt &&
                      request.resource.data.lastModifiedBy == null;
      
      // Admins can update any attendance record
      allow update: if isAdmin();
      
      // No client-side delete
      allow delete: if false;
    }

    // Audit logs - append only for admins
    match /attendance_audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // Settings - admins only
    match /settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}
